{
  "name": "@crazyglegit/support-storage-s3",
  "version": "0.0.0",
  "description": "S3-compatible storage adapter foundation for Support Kit",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@crazyglegit/support-contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0"
  }
}
