{
  "name": "@crazyglegit/support-realtime-socketio",
  "version": "0.0.0",
  "description": "Secure Socket.IO realtime adapter for Support Kit",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@crazyglegit/support": "workspace:*",
    "@crazyglegit/support-contracts": "workspace:*",
    "socket.io": "^4.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
