{
  "name": "@crazyglegit/support-db-drizzle",
  "version": "0.0.0",
  "description": "Drizzle database adapter foundation for Support Kit",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "node dist/migrate.js",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --exclude src/integration.test.ts --passWithNoTests",
    "test:integration": "vitest run src/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@crazyglegit/support-core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "^24.13.3",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.0.4"
  }
}
