{
  "name": "@crazyglegit/support-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the installable CrazygleGit customer support kit",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf .turbo coverage playwright-report test-results",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint tests/integration vitest.integration.config.ts --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "turbo run test && vitest run --config vitest.workspace.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@crazyglegit/support": "workspace:*",
    "@crazyglegit/support-db-drizzle": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "postgres": "3.4.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "testcontainers": "12.0.4",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
